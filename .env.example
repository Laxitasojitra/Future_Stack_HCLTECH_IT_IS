# Copy to .env and fill in. Without an API key the app runs in offline mode (rules + templates).

# LLM: groq (free tier) | gemini | openai | none
LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# hybrid = rules first, LLM only when the router is unsure | llm = LLM routes every question | rules = no LLM routing
ROUTER_MODE=hybrid
# Let the LLM rephrase verified answers (the verifier rejects any rephrasing that changes a number or citation)
LLM_REPHRASE=true

# Business clock of the dataset. Use "today" for the real date.
AS_OF_DATE=2026-10-24

# Demo login password for every user in data/raw/users.csv, and the token signing secret (32+ characters)
DEMO_PASSWORD=Hospital@123
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-characters

# Embeddings: auto (MiniLM, falls back to hashing offline) | minilm | hashing
EMBED_BACKEND=auto
